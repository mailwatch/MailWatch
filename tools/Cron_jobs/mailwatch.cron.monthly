# A script piped to syslog fails the pipeline when it fails
set -o pipefail

# Send the output to syslog, or discard it where logger is missing
to_syslog() {
    if command -v logger >/dev/null 2>&1; then
        logger -t "mailwatch-$1"
    else
        cat >/dev/null
    fi
}

# GeoIP Update
# Can be changed according to your need (time in second).
UPDATEMAXDELAY=3600

test -x /usr/local/bin/mailwatch_geoip_update.php || exit 0
sleep $[( $RANDOM % $UPDATEMAXDELAY )+1]s
# The exit status of the update is the exit status of this script
/usr/local/bin/mailwatch_geoip_update.php 2>&1 | to_syslog geoip-update
