# Send the output to syslog, or discard it where logger is missing
to_syslog() {
    if command -v logger >/dev/null 2>&1; then
        logger -t "mailwatch-$1"
    else
        cat >/dev/null
    fi
}

# Quarantine Maintenance
if [ -x /usr/local/bin/mailwatch_quarantine_maint.php ]; then
    /usr/local/bin/mailwatch_quarantine_maint.php --clean
fi

# Quarantine report
if [ -x /usr/local/bin/mailwatch_quarantine_report.php ]; then
    /usr/local/bin/mailwatch_quarantine_report.php 2>&1 | to_syslog quarantine-report
fi

# Clean MailWatch DB
if [ -x /usr/local/bin/mailwatch_db_clean.php ]; then
    /usr/local/bin/mailwatch_db_clean.php 2>&1 | to_syslog db-clean
fi

exit 0
