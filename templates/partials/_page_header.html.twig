{#
  The header block above every page: logo, message jump form, the signed-in
  user, the status panels and the navigation bar.

  It deliberately ends with an open table cell, because the page content is
  written after it and _footer.html.twig closes what is opened here.

  status_panels, traffic_graph, today_statistics and navigation arrive as
  markup already produced by the print* functions in functions.php. They are
  inserted unescaped and will become proper templates as each one is converted.
#}
<table border="0" cellpadding="5" width="100%">
<tr class="noprint">
<td>
<table border="0" cellpadding="0" cellspacing="0">
<tr>
<td align="left"><a href="index.php" class="logo"><img src="{{ logo_src }}" alt="{{ logo_alt }}"></a></td>
</tr>
<tr>
<td valign="bottom" align="left" class="jump">
<form action="./detail.php">
<p>{{ jump_label|raw }}<input type="text" name="id" value="{{ message_id }}"></p>
<input type="hidden" name="token" value="{{ token }}">
</form>
</td>
</tr>
</table>
<table cellspacing="1" class="mail">
<tr><td class="heading" align="center">{{ user_heading|raw }}</td><td class="heading" align="center">{{ clock_heading|raw }}</td></tr>
<tr><td>{{ full_name }}</td><td><span id="clock">&nbsp;</span></td></tr>
</table>
</td>
{% if status_panels is not null %}
<td align="center" valign="top">
<table border="0" cellpadding="1" cellspacing="1" class="mail">
<tr><th colspan="3">{{ status_heading|raw }}</th></tr>
{{ status_panels|raw }}
</table>
</td>
{{ traffic_graph|raw }}
{% endif %}
<td align="center" valign="top">
{{ today_statistics|raw }}
</td>
</tr>
{{ navigation|raw }}
<tr>
<td colspan="{{ colspan }}">
