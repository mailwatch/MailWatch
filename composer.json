{
    "name": "mailwatch/mailwatch",
    "description": "MailWatch for MailScanner",
    "license": "GPL-2.0-only",
    "type": "project",
    "require": {
        "php": "~8.5.12",
        "ext-mysqli": "*",
        "ext-pdo_mysql": "*",
        "ext-xml": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/migrations": "^3.9.8",
        "phpxmlrpc/phpxmlrpc": "^4.11.6",
        "psr/log": "^3.0.2",
        "symfony/mailer": "^6 || ^7 || ^8.1.10",
        "symfony/process": "^6 || ^7 || ^8.1.10",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "^3.95.28",
        "php-parallel-lint/php-console-highlighter": "^1.0.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.3.5",
        "phpunit/phpunit": "^10.5.66",
        "rector/rector": "^2.8.4",
        "symfony/var-dumper": "^6 || ^7 || ^8.1.10"
    },
    "suggest": {
        "ext-curl": "For node-to-node RPC over HTTPS",
        "ext-imap": "For IMAP support",
        "ext-ldap": "For LDAP support"
    },
    "autoload": {
        "psr-4": {
            "MailWatch\\": "src/MailWatch/",
            "MailWatch\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/fixtures/"
        ]
    },
    "config": {
        "platform": {
            "php": "8.5.12"
        },
        "sort-packages": true
    },
    "scripts": {
        "schema-verify": "php tools/verify-rest-api-schema.php"
    }
}
