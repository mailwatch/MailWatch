{
    "name": "mailwatch/mailwatch",
    "type": "project",
    "description": "MailWatch for MailScanner",
    "license": "GPL-2.0-only",
    "require": {
        "php": "8.3.* || 8.4.* || 8.5.*",
        "ext-mysqli": "*",
        "ext-pdo_mysql": "*",
        "doctrine/dbal": "^4.4",
        "doctrine/migrations": "^3.9",
        "twig/twig": "^3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "php-parallel-lint/php-console-highlighter": "^1.0.0",
        "rector/rector": "^2",
        "phpunit/phpunit": "^10.5",
        "symfony/var-dumper": "^6|^7|^8"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "suggest": {
        "ext-ldap": "For LDAP support",
        "ext-xml": "For XMLRPC support",
        "ext-imap": "For IMAP support"
    },
    "autoload": {
        "psr-4": {
            "MailWatch\\": "src/MailWatch/",
            "MailWatch\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/fixtures/"
        ]
    }
}
